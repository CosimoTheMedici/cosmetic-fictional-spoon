# ============================================================
# COSMETIX SHOP MANAGEMENT SYSTEM - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================

# Server
PORT=5000
NODE_ENV=production

# Database (MySQL on Namecheap cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cosmetics

# JWT Secret (generate a long random string, e.g. openssl rand -base64 64)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# Shop Info
SHOP_NAME=Cosmetix Beauty Shop
SHOP_CURRENCY=KES
SHOP_LOCATION=Mombasa, Kenya

# Low Stock Alert Threshold (default units before alert triggers)
DEFAULT_LOW_STOCK_THRESHOLD=10
